<?xml version="1.0" encoding="UTF-8"?>
<!--
  Colour scheme for FLORA, the gardener: soil green, leaf green, sunflower yellow, water blue.
  Used by her page (scripts/esp32/web), the GitHub Pages site, her exe and her app.

  Format: one colour per line, written exactly as  name="..." value="#RRGGBB".
-->
<colour_scheme>
  <!-- Surfaces -->
  <colour name="background"       value="#070D09"/>  <!-- window / page background -->
  <colour name="panel"            value="#0E1810"/>  <!-- cards, panels, idle buttons -->
  <colour name="border"           value="#1F3424"/>  <!-- panel edges, button outlines -->
  <colour name="divider"          value="#16261A"/>  <!-- lines between rows -->

  <!-- Text -->
  <colour name="text"             value="#EAF2E6"/>  <!-- primary text -->
  <colour name="text_sec"         value="#93A88F"/>  <!-- secondary text -->
  <colour name="text_dim"         value="#5F7360"/>  <!-- labels, section titles -->

  <!-- Accents -->
  <colour name="accent"           value="#7BC96F"/>  <!-- logo, links, selected / hover: leaf green -->
  <colour name="accent2"          value="#F2C14E"/>  <!-- sunflower yellow -->
  <colour name="water"            value="#5EB8F2"/>  <!-- moisture, the pump -->
  <colour name="bad"              value="#E86A5A"/>  <!-- stop, faults -->
</colour_scheme>
